# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Paystack secret key (Kenya: supports card + M-Pesa for KES).
# Get it from your Paystack dashboard -> Settings -> API Keys & Webhooks.
# Until this is set, "Checkout" falls back to placing the order over WhatsApp.
PAYSTACK_SECRET_KEY=

# Public site origin, used to resolve social preview (OpenGraph) image URLs.
# e.g. https://voltagefitness.co.ke — defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
